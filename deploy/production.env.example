# Copy to /etc/ai-consultant/production.env; owner ai-consultant-production, mode 0600.
APP_ENV=production
PUBLIC_BASE_URL=https://ai.exprofit.by
# Enable only at cutover, after stopping the local backend and checking old webhooks.
REGISTER_WEBHOOK=false
SERVER_HOST=127.0.0.1
SERVER_PORT=8100
PANEL_PORT=8501
DATABASE_PATH=/var/lib/ai-consultant/production/consultant.sqlite3
KNOWLEDGE_BASE_PATH=/srv/ai-consultant/production/current/knowledge_base
LOG_LEVEL=INFO
# Confirm the sender for the production account before enabling sends.
UMNICO_USER_ID=2583899
ADMIN_TOKEN=
WEBHOOK_TOKEN=
UMNICO_LOGIN=
UMNICO_PASSWORD=
UMNICO_API_KEY=
OPENROUTER_API_KEY=
# Optional HTTP(S) proxy for OpenRouter only; blank means direct access.
# Example: http://127.0.0.1:18080. Keep proxy credentials out of Git and logs.
OPENROUTER_PROXY_URL=
