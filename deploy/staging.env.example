# Copy to /etc/ai-consultant/staging.env; owner ai-consultant-staging, mode 0600.
APP_ENV=staging
# Staging always blocks both external APIs, regardless of this flag or credentials.
REGISTER_WEBHOOK=false
SERVER_HOST=127.0.0.1
SERVER_PORT=8101
PANEL_PORT=8502
DATABASE_PATH=/var/lib/ai-consultant/staging/consultant.sqlite3
KNOWLEDGE_BASE_PATH=/srv/ai-consultant/staging/current/knowledge_base
LOG_LEVEL=INFO
# Generate separate staging tokens; never copy the production environment or database.
ADMIN_TOKEN=
WEBHOOK_TOKEN=
UMNICO_LOGIN=
UMNICO_PASSWORD=
UMNICO_API_KEY=
OPENROUTER_API_KEY=
