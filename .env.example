# Секреты ai-consultant-bot. Остальные настройки задаются в config.py.
# Создайте .env на основе этого файла; существующий .env не перезаписывайте.
# config.py автоматически читает проектный .env при запуске: mise run start
# Секреты из переменных процесса имеют приоритет над файлом.
# Значения с пробелами или символом # заключайте в кавычки.

# Независимые случайные токены для администратора и URL webhook.
# Сгенерируйте нужный токен отдельным скриптом и перенесите выведенную строку в .env:
# mise exec -- uv run --no-sync python scripts/generate_admin_token.py
# mise exec -- uv run --no-sync python scripts/generate_webhook_token.py
# Пустой ADMIN_TOKEN отключает административные операции.
# Запросы администратора: Authorization: Bearer <ADMIN_TOKEN>.
ADMIN_TOKEN=
# WEBHOOK_TOKEN обязателен для обычного запуска с регистрацией webhook.
# Программа сама запросит текущий адрес туннеля и добавит путь с этим токеном.
# Полный URL содержит секрет: не публикуйте его и не сохраняйте в access-log прокси.
WEBHOOK_TOKEN=

# Umnico: выберите один способ авторизации.
# Вариант 1: заполните ОБА поля UMNICO_LOGIN и UMNICO_PASSWORD.
# Пароль в кавычках сохраняет начальные и конечные пробелы.
UMNICO_LOGIN=
UMNICO_PASSWORD=
# Вариант 2: оставьте login/password пустыми и укажите JWT доступа.
# Допустим токен без префикса или строка "JWT <token>"; Bearer не подходит.
# Если login/password заполнены, они имеют приоритет над UMNICO_API_KEY.
UMNICO_API_KEY=
# OpenRouter: ключ нужен для генерации консультаций; без него задания остаются в очереди.
OPENROUTER_API_KEY=
